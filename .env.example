# Runtime & Dev Server
PORT=3000
SA_ADMIN_HOST=0.0.0.0
SA_ADMIN_PORT=3000
SA_CONFIG_PATH=examples/config.local.json
SA_STATE_DIR=.superagent

# Admin Console Auth & Preview
SA_ADMIN_PASSWORD=
SA_ALLOW_IFRAME=1
SA_DEV_AUTO_AUTH=1

# Upstream LLM / Model Gateway
DEEPSEEK_API_KEY=
SA_DEEPSEEK_UPSTREAM=
SA_UPSTREAM_SESSION_HEADER=

# Storage & Vault
SA_WORKSPACE_ROOT=
SA_PROJECTS_ROOT=
SA_BACKUP_DIR=
SA_VAULT_KEY=
