{
  "name": "superagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "SA_ADMIN_HOST=0.0.0.0 SA_ADMIN_PORT=3000 SA_ALLOW_IFRAME=1 SA_DEV_AUTO_AUTH=1 node --experimental-transform-types src/daemon.ts --config examples/config.local.json",
    "start": "SA_ADMIN_HOST=0.0.0.0 SA_ADMIN_PORT=${PORT:-3000} node --experimental-transform-types src/daemon.ts --config examples/config.local.json",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "daemon": "node --experimental-transform-types src/daemon.ts",
    "sa": "node --experimental-transform-types src/cli/sa.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "imapflow": "2.10.2",
    "mailparser": "3.14.2",
    "nodemailer": "10.3.1",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.0",
    "@types/nodemailer": "8.0.2",
    "@types/yauzl": "3.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
