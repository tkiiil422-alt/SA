# Pi coding agent worker image, one image for every ticket kind.
#
# Build:  podman build -f deploy/Containerfile.pi -t localhost/superagent-pi:1.7.0 deploy/
# The image carries only Pi and the tools a worker is allowed to call. It holds no credentials: the ticket token and
# the gateway/MCP URLs arrive as environment variables at `podman run` time.
# BASE_IMAGE is the development image (`Containerfile.dev`, built on the console's 开发环境 page); without one the plain
# Node image is used and the essential CLI tools (git, ssh, rsync, patch, curl, python3, ripgrep) are installed below.
ARG BASE_IMAGE=docker.io/library/node:22-bookworm-slim
FROM ${BASE_IMAGE}
# Re-declared after FROM so the label and mirror args are visible in build layers.
ARG BASE_IMAGE
ARG APT_MIRROR=mirrors.aliyun.com
ARG NPM_REGISTRY=https://registry.npmmirror.com
LABEL io.superagent.base="${BASE_IMAGE}"
USER root

# The dev image already carries these; a plain base gets the essentials Pi & SSH/patch workflows need.
RUN set -eux; \
  if ! command -v git >/dev/null || ! command -v rg >/dev/null || ! command -v python3 >/dev/null \
     || ! command -v ssh >/dev/null || ! command -v patch >/dev/null || ! command -v rsync >/dev/null; then \
    if [ -n "$APT_MIRROR" ] && [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i "s|deb.debian.org|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 install -y --no-install-recommends \
      ca-certificates git less procps python3 ripgrep \
      curl jq patch openssh-client rsync; \
    rm -rf /var/lib/apt/lists/*; \
  fi

# Git authenticates with the ticket's GITHUB_TOKEN: the helper answers `git credential fill` from the environment, so
# `git clone/push https://github.com/<owner>/<repo>` works without a credential file. Identity defaults keep commits valid.
RUN git config --system credential.https://github.com.helper '!f() { test "$1" = get && echo username=x-access-token && echo "password=$GITHUB_TOKEN"; }; f' \
 && git config --system user.name superagent \
 && git config --system user.email superagent@localhost

# Pin the agent version: an unpinned update would silently change the RPC protocol under the executor.
# Try configured NPM_REGISTRY first with retries; if a mirror has not synced a freshly published version or fails,
# automatically fall back to the official npm registry so transient ECONNRESET / mirror lag does not fail the build.
ARG PI_VERSION=1.7.0
RUN set -eux; \
  install_pi() { \
    reg="$1"; \
    for attempt in 1 2 3; do \
      echo "Installing @earendil-works/pi-coding-agent@${PI_VERSION} (attempt ${attempt}, registry=${reg:-official})"; \
      if npm install -g ${reg:+--registry="$reg"} \
          --fetch-retries=5 --fetch-retry-mintimeout=2000 --fetch-retry-maxtimeout=15000 \
          "@earendil-works/pi-coding-agent@${PI_VERSION}"; then \
        return 0; \
      fi; \
      sleep $((attempt * 2)); \
    done; \
    return 1; \
  }; \
  if [ -n "$NPM_REGISTRY" ]; then \
    install_pi "$NPM_REGISTRY" || { echo "Mirror failed, falling back to https://registry.npmjs.org"; install_pi "https://registry.npmjs.org"; }; \
  else \
    install_pi "https://registry.npmjs.org"; \
  fi; \
  npm cache clean --force

# The base image already ships uid 1000 as `node`; `--userns=keep-id` maps the host user onto it so mounted files stay
# writable without running the container as root.
USER node
WORKDIR /workspace

# No ENTRYPOINT: the launcher passes the full `pi ...` command line, which keeps the image usable for one-off
# `podman run ... pi --help` checks.
CMD ["pi", "--help"]
